# ---- Backend environment (copy to .env and fill real values) ----

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8081

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/igohms?retryWrites=true&w=majority

# Set to true ONLY for local dev without Atlas/Firebase — starts an in-memory MongoDB
# and overrides MONGODB_URI. NEVER enable in production.
DEV_LOCAL_MODE=false

# Set to true to register POST /auth/dev-login (demo login buttons) when NODE_ENV !== 'production'.
# Lets you use Atlas + dev-login together. Independent of DEV_LOCAL_MODE. NEVER enable in production.
ENABLE_DEV_LOGIN=false

# Firebase Admin SDK (service account JSON). Place the real file at backend/serviceAccountKey.json (gitignored).
# The path is read at startup; do NOT commit the key file.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Frontend reCAPTCHA verify uses this secret (v2 checkbox)
RECAPTCHA_SECRET_KEY=your_recaptcha_v2_secret_here

# OTP for email/password sign-up
# Options: 'firebase' (use Firebase Admin to send) | 'smtp' (nodemailer via SMTP)
OTP_PROVIDER=firebase
# If OTP_PROVIDER=smtp, fill SMTP_* below
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
OTP_TTL_MINUTES=10

# JWT signing key (native session token issued AFTER Firebase ID-token verification, for our own stateful sessions)
SESSION_SIGNING_KEY=replace_with_a_long_random_string_min_64_chars
SESSION_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# Brute-force lockout
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCK_MS=900000

# Local storage root used by the S3-compatible local-fs storage driver (dev only)
STORAGE_LOCAL_ROOT=.storage

# Rate limiting (per-IP + per-user on auth routes)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=50
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=10

# OpenRouter API key for the AI assistant (uses free models with automatic fallback). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
